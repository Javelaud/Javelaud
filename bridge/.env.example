# Bridge API - Variables d'environnement
# Copiez ce fichier en .env et renseignez vos valeurs

# Identifiants de l'application Bridge (obtenus sur https://dashboard.bridgeapi.io)
BRIDGE_CLIENT_ID=your_client_id_here
BRIDGE_CLIENT_SECRET=your_client_secret_here

# Token d'accès de l'utilisateur (généré après authentification)
BRIDGE_USER_TOKEN=

# Clé secrète JWT — À changer absolument en production
SECRET_KEY=changeme_secret_jwt_key_please_change_in_prod

# Base de données SQLite
DATABASE_URL=sqlite:///./sasu.db

# Compte expert créé au démarrage (si aucun expert n'existe)
EXPERT_EMAIL=expert@javelaud.fr
EXPERT_PASSWORD=changeme123

# SMTP — Envoi des emails d'invitation
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@javelaud.fr
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=Javelaud <no-reply@javelaud.fr>

# URL de l'application (pour les liens dans les emails)
APP_URL=https://creation.javelaud.fr

# Oneflow — Signature électronique
ONEFLOW_API_TOKEN=your_oneflow_api_token
ONEFLOW_WORKSPACE_ID=your_workspace_id

# Répertoire de stockage des fichiers uploadés
UPLOAD_DIR=./uploads
